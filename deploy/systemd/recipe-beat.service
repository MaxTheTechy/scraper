[Unit]
Description=Recipe Scraper Platform - Celery beat scheduler
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=recipe
Group=recipe
WorkingDirectory=/opt/scraper
EnvironmentFile=/opt/scraper/.env
ExecStart=/opt/scraper/venv/bin/celery -A scraper.worker beat --loglevel=info --schedule=/data/celery/celerybeat-schedule
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
